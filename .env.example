# ================================================================
# Dine&Stay OS — Next.js Frontend Environment
# ================================================================

# ─── App Core ───────────────────────────────────────────────────
NODE_ENV=development
APP_NAME="Dine&Stay OS"
APP_URL=http://localhost:3000

# ─── API Connection (Render Cloud Backend) ──────────────────────
API_URL=https://dinestay-backend-dubd.onrender.com
NEXT_PUBLIC_API_URL=https://dinestay-backend-dubd.onrender.com
NEXT_PUBLIC_API_HOST=https://dinestay-backend-dubd.onrender.com

# ─── Frontend Feature Flags ─────────────────────────────────────
ENABLE_MULTI_BRANCH=true
ENABLE_HOTEL_MODULE=false

# ─── Next.js Client Integrations ────────────────────────────────
# Third-party SDKs that the frontend might still load directly
CLOUDINARY_CLOUD_NAME=
RAZORPAY_KEY_ID=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_PROJECT_WEB=dinestay-web